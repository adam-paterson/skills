{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adam-paterson/skills/schemas/catalog.schema.json",
  "title": "Agent Skills Catalog Config",
  "type": "object",
  "required": [
    "repository",
    "plugin",
    "wellKnown",
    "skillsSh",
    "domains"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "repository": {
      "type": "object",
      "required": [
        "owner",
        "name",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "plugin": {
      "type": "object",
      "required": [
        "name",
        "displayName",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "wellKnown": {
      "type": "object",
      "required": [
        "schema",
        "basePath"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "basePath": {
          "type": "string",
          "pattern": "^/.+/$"
        }
      }
    },
    "skillsSh": {
      "type": "object",
      "required": [
        "schema",
        "notGrouped"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "notGrouped": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "hidden"
          ]
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
