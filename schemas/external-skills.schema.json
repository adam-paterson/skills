{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External Skill Sources",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repo", "skills"],
        "properties": {
          "id": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "url": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "stage", "required", "reason"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "stage": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
